local WaveSystem = {}

local MaxZombies = 3
local SpawnTime = 10
local Wave = 0

local health = 100

local ZombieFolder = game.Workspace.Zombies

local Zombies = game.ReplicatedStorage.Zombies

local Rarities = require(script.Parent.ZombieRarity)

local rng = Random.new()
local function GetRandomZombie()
	-- 1. Calculate the total weight of all items combined
	local totalChance = 0
	for _, item in pairs(Rarities) do
		totalChance += item.Chance
	end

	-- 2. Pick a random number between 0 and the total weight
	local randomNumber = rng:NextNumber(0, totalChance)

	-- 3. Loop through the table and subtract weights until we hit the target
	local cumulativeChance = 0
	for _, item in pairs(Rarities) do
		cumulativeChance += item.Chance
		if randomNumber <= cumulativeChance then
			return item.Zombie
		end
	end
end

function WaveSystem.Zombies(roundTime, SpawnParts, mapName)
	local endTime = os.clock() + roundTime

	-- Keep spawning waves continuously until roundTime ends
	while os.clock() < endTime do
		if #ZombieFolder:GetChildren() < MaxZombies then
			Wave += 1

			local initialWait = math.min(1, endTime - os.clock())
			if initialWait <= 0 then
				break
			end
			task.wait(initialWait)

			print("Wave:", Wave)
			for _, Spwn in pairs(SpawnParts:GetChildren()) do
				if os.clock() >= endTime then
					break
				end

				local RandomZombie = GetRandomZombie()
				if Spwn:IsA("BasePart") then
					local RandomNum = math.random(1, 3)
					local ZombieClone = Zombies[mapName]:FindFirstChild(RandomZombie):Clone()

					local timeLeft = endTime - os.clock()
					if timeLeft <= 0 then
						ZombieClone:Destroy()
						break
					end

					task.wait(math.min(RandomNum, timeLeft))

					if os.clock() >= endTime then
						ZombieClone:Destroy()
						break
					end

					ZombieClone.Parent = game.Workspace.Zombies
					ZombieClone.HumanoidRootPart.CFrame = Spwn.CFrame * CFrame.new(0, 3, 0)
					ZombieClone.Humanoid.Health = health
				end
			end

			health += 100
		end

		-- Small pause before checking for the next wave so the server doesn't freeze
		task.wait(1)
	end

	-- Clear all zombies immediately when the round ends
	ZombieFolder:ClearAllChildren()
end

return WaveSystem
